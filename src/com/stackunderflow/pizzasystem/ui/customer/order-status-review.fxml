<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stackunderflow.pizzasystem.ui.customer.OrderStatusController">
   <top>
      <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #fff; -fx-padding: 20; -fx-border-color: lightgray; -fx-border-width: 0 0 1 0;">
         <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Track Your Order" />
         <Label fx:id="orderIdLabel" style="-fx-text-fill: gray; -fx-font-size: 16px;" text="Order #000" />
      </VBox>
   </top>
   
   <center>
      <VBox alignment="TOP_CENTER" spacing="30.0" style="-fx-padding: 40 20;">
         
         <ProgressBar fx:id="statusProgress" prefWidth="300.0" progress="0.0" />
         
         <VBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 0 60;">
            <Label fx:id="statusReceived" text="○ Order Received" style="-fx-font-size: 14px; -fx-text-fill: gray;" />
            <Label fx:id="statusOven" text="○ In the Oven" style="-fx-font-size: 14px; -fx-text-fill: gray;" />
            <Label fx:id="statusQuality" text="○ Quality Check" style="-fx-font-size: 14px; -fx-text-fill: gray;" />
            <Label fx:id="statusReady" text="○ Ready for Pickup/Delivery" style="-fx-font-size: 14px; -fx-text-fill: gray;" />
         </VBox>

      </VBox>
   </center>
   
   <bottom>
      <VBox style="-fx-padding: 20;">
         <Button maxWidth="Infinity" onAction="#handleBackHome" style="-fx-background-color: #ff6347; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10;" text="Back to Home" />
      </VBox>
   </bottom>
</BorderPane>