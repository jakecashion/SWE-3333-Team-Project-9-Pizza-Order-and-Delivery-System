<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stackunderflow.pizzasystem.ui.customer.OrderSummaryController">
   <top>
      <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #fff; -fx-padding: 20; -fx-border-color: lightgray; -fx-border-width: 0 0 1 0;">
         <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Your Receipt" />
         <Label style="-fx-text-fill: gray;" text="Mom &amp; Pop's Pizzeria" />
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
         <content>
            <VBox fx:id="receiptContainer" spacing="10.0">
               <padding>
                  <Insets bottom="20" left="20" right="20" top="20" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   
   <bottom>
      <VBox spacing="10.0" style="-fx-padding: 20; -fx-background-color: #f4f4f4; -fx-border-color: lightgray; -fx-border-width: 1 0 0 0;">
         <HBox alignment="CENTER_LEFT">
            <Label style="-fx-font-size: 14px;" text="Subtotal:" />
            <Pane HBox.hgrow="ALWAYS" />
            <Label fx:id="subtotalLabel" style="-fx-font-size: 14px;" text="\$0.00" />
         </HBox>
         <HBox alignment="CENTER_LEFT">
            <Label style="-fx-font-size: 14px;" text="Tax (6%):" />
            <Pane HBox.hgrow="ALWAYS" />
            <Label fx:id="taxLabel" style="-fx-font-size: 14px;" text="\$0.00" />
         </HBox>
         <Separator />
         <HBox alignment="CENTER_LEFT">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Total:" />
            <Pane HBox.hgrow="ALWAYS" />
            <Label fx:id="totalLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: green;" text="\$0.00" />
         </HBox>
         
         <Button maxWidth="Infinity" onAction="#handlePlaceOrder" style="-fx-background-color: #ff6347; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 10;" text="Confirm &amp; Pay" />
         <Button maxWidth="Infinity" onAction="#handleBack" text="Keep Shopping" />
      </VBox>
   </bottom>
</BorderPane>