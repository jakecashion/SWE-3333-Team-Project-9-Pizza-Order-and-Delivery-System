<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stackunderflow.pizzasystem.ui.customer.MenuController">
   <top>
      <HBox alignment="CENTER" style="-fx-background-color: #ff6347; -fx-padding: 20;">
         <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="Mom and Pop's Pizzeria Menu" />
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
         <content>
            <VBox fx:id="menuContainer" spacing="15.0">
               <padding>
                  <Insets bottom="20" left="20" right="20" top="20" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>

   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="20.0" style="-fx-padding: 20; -fx-border-color: lightgray; -fx-border-width: 1 0 0 0;">
         <Label fx:id="countLabel" style="-fx-font-size: 14px;" text="Items Ordered: 0" />
         <Label fx:id="totalLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Total: $0.00" />
         
         <Button fx:id="checkoutButton" onAction="#handleCheckout" style="-fx-background-color: green; -fx-text-fill: white; -fx-font-weight: bold;" text="Proceed to Checkout" />
         
         <Button onAction="#handleBack" text="Back to Home" />
      </HBox>
   </bottom>
</BorderPane>