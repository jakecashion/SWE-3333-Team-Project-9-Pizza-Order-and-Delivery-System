<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stackunderflow.pizzasystem.ui.customer.MenuController">
   <top>
      <HBox alignment="CENTER" style="-fx-background-color: #ff6347; -fx-padding: 20;">
         <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="Mom and Pop's Pizzeria Menu" />
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F5F5F5;">
         <content>
            <VBox spacing="25.0" style="-fx-padding: 20; -fx-background-color: #F5F5F5;">
               
               <VBox spacing="10.0">
                  <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Specialty Pizzas" />
                  <ScrollPane fitToHeight="true" vbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                     <content>
                        <HBox fx:id="pizzaContainer" spacing="20.0" style="-fx-padding: 5;">
                           </HBox>
                     </content>
                  </ScrollPane>
               </VBox>

               <VBox spacing="10.0">
                  <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Beverages" />
                  <ScrollPane fitToHeight="true" vbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                     <content>
                        <HBox fx:id="drinkContainer" spacing="20.0" style="-fx-padding: 5;">
                           </HBox>
                     </content>
                  </ScrollPane>
               </VBox>

               <VBox spacing="10.0">
                  <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Sides &amp; Desserts" />
                  <ScrollPane fitToHeight="true" vbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                     <content>
                        <HBox fx:id="sideContainer" spacing="20.0" style="-fx-padding: 5;">
                           </HBox>
                     </content>
                  </ScrollPane>
               </VBox>

            </VBox>
         </content>
      </ScrollPane>
   </center>

   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="20.0" style="-fx-padding: 20; -fx-background-color: white; -fx-border-color: lightgray; -fx-border-width: 1 0 0 0;">
         <Label fx:id="countLabel" style="-fx-font-size: 14px;" text="Items: 0" />
         <Label fx:id="totalLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Total: $0.00" />
         <Button fx:id="checkoutButton" onAction="#handleCheckout" style="-fx-background-color: green; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 20;" text="Proceed to Checkout" />
         <Button onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #555;" text="Back to Home" />
      </HBox>
   </bottom>
</BorderPane>