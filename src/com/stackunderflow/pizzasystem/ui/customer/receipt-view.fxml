<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stackunderflow.pizzasystem.ui.customer.ReceiptController">
   <top>
      <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #4CAF50; -fx-padding: 20;">
         <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" text="Order Confirmed!" />
         <Label style="-fx-font-size: 14px; -fx-text-fill: white;" text="Thank you for your purchase" />
      </VBox>
   </top>
   
   <center>
      <VBox spacing="15.0" style="-fx-padding: 20;">
         <VBox alignment="CENTER" spacing="5">
            <Label fx:id="orderIdLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Order #000" />
            <Label fx:id="orderTypeLabel" style="-fx-font-size: 14px; -fx-text-fill: gray;" text="Order Type: Pickup" />
         </VBox>
         
         <Separator />
         
         <Label style="-fx-font-weight: bold;" text="Items Ordered:" />
         <ScrollPane fitToWidth="true" prefHeight="200.0" style="-fx-background-color: transparent;">
            <content>
               <VBox fx:id="itemsContainer" spacing="8.0" />
            </content>
         </ScrollPane>
         
         <Separator />
         
         <VBox alignment="CENTER_RIGHT">
            <Label fx:id="totalLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Total Paid: $0.00" />
         </VBox>
      </VBox>
   </center>
   
   <bottom>
      <VBox style="-fx-padding: 20;" spacing="10">
         <Button maxWidth="Infinity" onAction="#handleTrackOrder" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10;" text="Track Order Status" />
         
         <Button maxWidth="Infinity" onAction="#handleHome" style="-fx-background-color: #ff6347; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10;" text="Back to Home" />
      </VBox>
   </bottom>
</BorderPane>